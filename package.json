{
  "name": "gains-log-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "Static frontend for the Gains Log gym tracker (calls a separately hosted gains-log-backend)",
  "scripts": {
    "build": "tailwindcss -i src/styles/main.css -o public/css/styles.css --minify",
    "dev": "tailwindcss -i src/styles/main.css -o public/css/styles.css --watch",
    "serve": "npx serve public"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  }
}
